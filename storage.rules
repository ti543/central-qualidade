rules_version = '2';

// Regras do Firebase Storage para a Central da Qualidade.
//
// Leitura: qualquer usuário autenticado no sistema pode baixar os
// documentos da Biblioteca (Manual da Qualidade, PG, IT, etc.) — é
// conteúdo de referência da empresa, não precisa de papel específico.
//
// Escrita: bloqueada para qualquer cliente. O upload/atualização dos
// documentos é feito só pelo script administrativo (Admin SDK, usando
// a chave de serviço), nunca pelo navegador. Isso evita que alguém
// logado suba ou apague arquivos direto pelo site.
service firebase.storage {
  match /b/{bucket}/o {
    match /biblioteca_documentos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Qualquer outro caminho no bucket: bloqueado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
