rules_version = '2';

// ============================================================================
// REGRAS DO FIREBASE STORAGE — Central de Qualidade
// Cole isto em: Firebase Console > Storage > Regras > Publicar.
//
// Só o módulo "Aprovação de Documentos" usa Storage (upload de PDF/Word dos
// documentos). Igual ao Firestore: só quem tem papel 'qualidade' pode enviar
// ou apagar arquivo — confere isso consultando o perfil salvo no Firestore.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /documentos_aprovacao/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios_perfil/$(request.auth.uid)).data.papel == 'qualidade';
    }
  }
}
